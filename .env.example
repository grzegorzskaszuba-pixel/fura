# local (default) keeps auth in browser IndexedDB
VITE_AUTH_MODE=local
VITE_HOST=0.0.0.0
VITE_PORT=5173

# used when VITE_AUTH_MODE=remote
VITE_API_BASE_URL=/api
VITE_API_PROXY_TARGET=http://127.0.0.1:8787

# optional: enables workshop location autocomplete and mini map preview
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# optional: comma-separated list of allowed browser origins for direct API calls
# (for example when frontend and API are on different hosts/ports)
# AUTH_API_ALLOWED_ORIGINS=http://localhost:5173,http://192.168.50.4:5173
